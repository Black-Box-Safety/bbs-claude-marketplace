{
  "_doc": "Shared cases for fill-gate.py and fill-gate.ps1 (fill_gate_parity.py, run-tests.ps1). Placeholders: {L} launcher path, {S} vetted script (ca-form-filler fill_obs_packet.py), {P} vetted script (packet_profile.py), {R} plugin root, {U} unvetted script in the same folder. 'setup' names a fixture variant; 'tool' and 'input' override the payload; 'env_root' replaces CLAUDE_PLUGIN_ROOT ('{R}' is the root, null unsets it). expect: allow | none. Spec: docs/superpowers/specs/2026-11-11-bbs-fill-into-bbs-sales.md section 8.",
  "cases": [
    {"id": "skill-form", "cmd": "\"{L}\" \"{S}\" in.pdf inputs.json out.pdf", "expect": "allow", "why": "the form the skills write"},
    {"id": "single-quotes", "cmd": "'{L}' '{S}' --inspect 'Packet B (2026).pdf'", "expect": "allow", "why": "single quotes, spaces in an argument"},
    {"id": "unquoted", "cmd": "{L} {S} --validate", "expect": "allow", "why": "unquoted ASCII root"},
    {"id": "concat-word0", "cmd": "\"{R}/scripts/\"bbs-fill \"{S}\"", "expect": "allow", "why": "word 0 built from quoted and unquoted runs"},
    {"id": "windows-arg", "cmd": "\"{L}\" \"{S}\" \"D:\\Quotes\\Desk\\out.pdf\"", "expect": "allow", "why": "a Windows path as data"},
    {"id": "nfd-arg", "cmd": "\"{L}\" \"{S}\" \"Ca\u0301fe\u0301.pdf\"", "expect": "allow", "why": "NFD name inside quotes"},
    {"id": "nonbmp-arg", "cmd": "\"{L}\" \"{S}\" \"\ud835\udc9c.pdf\"", "expect": "allow", "why": "non-BMP letter inside quotes"},
    {"id": "dash-c-is-data", "cmd": "\"{L}\" \"{S}\" -c \"import os\"", "expect": "allow", "why": "arguments are data"},
    {"id": "empty-arg", "cmd": "\"{L}\" \"{S}\" \"\"", "expect": "allow", "why": "empty argument"},
    {"id": "packet-profile", "cmd": "\"{L}\" \"{P}\" --list", "expect": "allow", "why": "another vetted script"},
    {"id": "root-space", "setup": "root-space", "cmd": "\"{L}\" \"{S}\" x", "expect": "allow", "why": "root containing a space"},
    {"id": "root-nonascii", "setup": "root-nonascii", "cmd": "\"{L}\" \"{S}\" x", "expect": "allow", "why": "root containing non-ASCII and a non-BMP letter"},
    {"id": "root-trailing-slash", "env_root": "{R}/", "cmd": "\"{L}\" \"{S}\" x", "expect": "allow", "why": "CLAUDE_PLUGIN_ROOT with a trailing /"},
    {"id": "sandbox-false", "input": {"dangerouslyDisableSandbox": false}, "cmd": "\"{L}\" \"{S}\"", "expect": "allow", "why": "explicit false is fine"},

    {"id": "semicolon", "cmd": "\"{L}\" \"{S}\" a; rm -rf x", "expect": "none", "why": "compound"},
    {"id": "and", "cmd": "\"{L}\" \"{S}\" && echo hi", "expect": "none", "why": "compound"},
    {"id": "pipe", "cmd": "\"{L}\" \"{S}\" | tee x", "expect": "none", "why": "pipe"},
    {"id": "background", "cmd": "\"{L}\" \"{S}\" &", "expect": "none", "why": "background"},
    {"id": "or", "cmd": "\"{L}\" \"{S}\" || x", "expect": "none", "why": "compound"},
    {"id": "redirect-out", "cmd": "\"{L}\" \"{S}\" > out", "expect": "none", "why": "redirect"},
    {"id": "redirect-2", "cmd": "\"{L}\" \"{S}\" 2>&1", "expect": "none", "why": "redirect"},
    {"id": "redirect-in", "cmd": "\"{L}\" \"{S}\" < in", "expect": "none", "why": "redirect"},
    {"id": "heredoc", "cmd": "\"{L}\" \"{S}\" <<EOF", "expect": "none", "why": "here-document"},
    {"id": "cmdsub", "cmd": "\"{L}\" \"{S}\" $(id)", "expect": "none", "why": "command substitution"},
    {"id": "backtick", "cmd": "\"{L}\" \"{S}\" `id`", "expect": "none", "why": "command substitution"},
    {"id": "cmdsub-dq", "cmd": "\"{L}\" \"{S}\" \"$(id)\"", "expect": "none", "why": "substitution inside double quotes"},
    {"id": "param-dq", "cmd": "\"{L}\" \"{S}\" \"$HOME\"", "expect": "none", "why": "parameter expansion"},
    {"id": "param-brace", "cmd": "\"{L}\" \"{S}\" ${X}", "expect": "none", "why": "parameter expansion"},
    {"id": "procsub", "cmd": "\"{L}\" \"{S}\" <(x)", "expect": "none", "why": "process substitution"},
    {"id": "subshell", "cmd": "(\"{L}\" \"{S}\")", "expect": "none", "why": "subshell"},
    {"id": "group", "cmd": "{ \"{L}\" \"{S}\"; }", "expect": "none", "why": "group"},
    {"id": "brace", "cmd": "\"{L}\" \"{S}\" {a,b}", "expect": "none", "why": "brace expansion"},
    {"id": "glob", "cmd": "\"{L}\" \"{S}\" *.pdf", "expect": "none", "why": "glob"},
    {"id": "tilde", "cmd": "\"{L}\" \"{S}\" ~/x", "expect": "none", "why": "tilde"},
    {"id": "comment", "cmd": "\"{L}\" \"{S}\" #c", "expect": "none", "why": "comment"},
    {"id": "zsh-equals-arg", "cmd": "\"{L}\" \"{S}\" =ls", "expect": "none", "why": "zsh EQUALS"},
    {"id": "zsh-equals-word0", "cmd": "=bash \"{S}\"", "expect": "none", "why": "zsh EQUALS"},
    {"id": "dq-bang", "cmd": "\"{L}\" \"{S}\" \"a!b\"", "expect": "none", "why": "history char in double quotes"},
    {"id": "dq-escape", "cmd": "\"{L}\" \"{S}\" \"a\\\"b\"", "expect": "none", "why": "escaped quote in double quotes"},
    {"id": "unquoted-backslash", "cmd": "\"{L}\" \"{S}\" a\\ b", "expect": "none", "why": "unquoted backslash"},
    {"id": "newline", "cmd": "\"{L}\" \"{S}\" a\nrm x", "expect": "none", "why": "newline"},
    {"id": "cr", "cmd": "\"{L}\" \"{S}\" a\rb", "expect": "none", "why": "CR"},
    {"id": "tab", "cmd": "\"{L}\"\t\"{S}\"", "expect": "none", "why": "tab"},
    {"id": "nul", "cmd": "\"{L}\" \"{S}\" a\u0000b", "expect": "none", "why": "NUL"},
    {"id": "nel", "cmd": "\"{L}\" \"{S}\" \"a\u0085b\"", "expect": "none", "why": "C1 control inside quotes"},
    {"id": "ls", "cmd": "\"{L}\" \"{S}\" \"a\u2028b\"", "expect": "none", "why": "line separator inside quotes"},
    {"id": "replacement-char", "cmd": "\"{L}\" \"{S}\" \"a\ufffdb\"", "expect": "none", "why": "U+FFFD (what PowerShell makes of a lone surrogate)"},
    {"id": "lone-surrogate", "cmd": "\"{L}\" \"{S}\" \"a\ud800b\"", "expect": "none", "why": "lone surrogate"},
    {"id": "unterminated-sq", "cmd": "\"{L}\" \"{S}\" 'abc", "expect": "none", "why": "unterminated quote"},
    {"id": "unterminated-dq", "cmd": "\"{L}\" \"{S}\" \"abc", "expect": "none", "why": "unterminated quote"},
    {"id": "nonascii-unquoted", "cmd": "\"{L}\" \"{S}\" caf\u00e9.pdf", "expect": "none", "why": "non-ASCII outside quotes"},
    {"id": "nonbmp-unquoted", "cmd": "\"{L}\" \"{S}\" \ud835\udc9c.pdf", "expect": "none", "why": "non-BMP outside quotes"},
    {"id": "env-pythonpath", "cmd": "PYTHONPATH=/x \"{L}\" \"{S}\"", "expect": "none", "why": "env injection"},
    {"id": "env-ldpreload", "cmd": "LD_PRELOAD=x \"{L}\" \"{S}\"", "expect": "none", "why": "env injection"},
    {"id": "env-bashenv", "cmd": "BASH_ENV=x \"{L}\" \"{S}\"", "expect": "none", "why": "env injection"},
    {"id": "wrap-env", "cmd": "env X=1 \"{L}\" \"{S}\"", "expect": "none", "why": "wrapper"},
    {"id": "wrap-exec", "cmd": "exec \"{L}\" \"{S}\"", "expect": "none", "why": "wrapper"},
    {"id": "wrap-bash", "cmd": "bash \"{L}\" \"{S}\"", "expect": "none", "why": "wrapper"},
    {"id": "wrap-command", "cmd": "command \"{L}\" \"{S}\"", "expect": "none", "why": "wrapper"},
    {"id": "literal-var", "cmd": "\"${CLAUDE_PLUGIN_ROOT}/scripts/bbs-fill\" \"{S}\"", "expect": "none", "why": "unexpanded variable"},
    {"id": "other-root", "cmd": "/other/bbs-sales/9.9.9/scripts/bbs-fill \"{S}\"", "expect": "none", "why": "launcher outside this root"},
    {"id": "other-version", "setup": "other-version", "cmd": "\"{R2}/scripts/bbs-fill\" \"{R2}/skills/ca-form-filler/scripts/fill_obs_packet.py\"", "expect": "none", "why": "another installed version"},
    {"id": "launcher-suffix", "cmd": "\"{L}x\" \"{S}\"", "expect": "none", "why": "not the launcher"},
    {"id": "root-case", "cmd": "\"{Lcase}\" \"{S}\"", "expect": "none", "why": "root differs only in case: no folding"},
    {"id": "root-nfc-nfd", "setup": "root-nonascii", "cmd": "\"{Lnfd}\" \"{S}\"", "expect": "none", "why": "root differs only in NFC/NFD form"},
    {"id": "unvetted", "cmd": "\"{L}\" \"{U}\"", "expect": "none", "why": "not on ALLOWED"},
    {"id": "outside-script", "cmd": "\"{L}\" /tmp/fill_obs_packet.py", "expect": "none", "why": "not in this root"},
    {"id": "dotdot", "cmd": "\"{L}\" \"{R}/skills/../skills/ca-form-filler/scripts/fill_obs_packet.py\"", "expect": "none", "why": ".. segment"},
    {"id": "launcher-alone", "cmd": "\"{L}\"", "expect": "none", "why": "no script"},
    {"id": "option-first", "cmd": "\"{L}\" -c x", "expect": "none", "why": "an option, not a script"},
    {"id": "link-skill", "setup": "link-skill", "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "skill folder is a link"},
    {"id": "link-launcher", "setup": "link-launcher", "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "launcher is a link"},
    {"id": "link-scripts", "setup": "link-scripts", "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "scripts/ is a link"},
    {"id": "link-root", "setup": "link-root", "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "the root itself is a link"},
    {"id": "crlf-launcher", "setup": "crlf", "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "CRLF launcher: no decision for every command"},
    {"id": "bad-entry-dotdot", "setup": "bad-entry-dotdot", "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "malformed ALLOWED entry: no decision for every command"},
    {"id": "bad-entry-shape", "setup": "bad-entry-shape", "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "malformed ALLOWED entry: no decision for every command"},
    {"id": "sandbox-off", "input": {"dangerouslyDisableSandbox": true}, "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "outside scope"},
    {"id": "tool-powershell", "tool": "PowerShell", "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "outside scope"},
    {"id": "no-root", "env_root": null, "cmd": "\"{L}\" \"{S}\"", "expect": "none", "why": "no CLAUDE_PLUGIN_ROOT"},
    {"id": "not-json", "raw": "not json {L}", "cmd": "", "expect": "none", "why": "stdin not JSON"}
  ]
}
