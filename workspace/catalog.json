{
  "named": [
    { "id": "bbs-shopify", "names": ["bbs-shopify"] },
    { "id": "bbs-database", "names": ["bbs-database"] },
    { "id": "bbs-quote-bot", "names": ["bbs-quote-bot"] },
    { "id": "bbs-customer-bots", "names": ["bbs-customer-bots"] },
